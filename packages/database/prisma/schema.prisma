model Decision {
  id             String  @id @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  workspaceId    String  @map("workspace_id") @db.Uuid
  correlationId  String? @unique @map("correlation_id") @db.Uuid
  strategyId     String? @map("strategy_id") @db.Uuid
  accountId      String  @map("account_id") @db.Uuid
  symbolId       String  @map("symbol_id") @db.Uuid

  outcome         String  @db.VarChar(50)
  status          String  @db.VarChar(50)
  confidenceScore Decimal @map("confidence_score") @db.Decimal(5, 2)
  explanation     String  @db.Text
  context         String  @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([organizationId])
  @@index([status])
  @@map("decisions")
}

model DecisionCorrelation {
  correlationId      String   @id @map("correlation_id") @db.Uuid
  organizationId     String?  @map("organization_id") @db.Uuid
  workspaceId        String   @map("workspace_id") @db.Uuid
  opportunityPayload String?  @map("opportunity_payload") @db.Text
  riskPayload        String?  @map("risk_payload") @db.Text
  status             String   @default("PENDING") @db.VarChar(30)
  expiresAt          DateTime @map("expires_at") @db.Timestamp(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([organizationId])
  @@index([status, expiresAt])
  @@map("decision_correlations")
}

// -----------------------------------------------------------------------------
// POLICY SCHEMA
// -----------------------------------------------------------------------------

model Policy {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  name           String   @db.VarChar(255)
  description    String?  @db.Text
  scope          String   @db.VarChar(50) // ORGANIZATION, WORKSPACE, ACCOUNT, STRATEGY, SYMBOL
  status         String   @default("DRAFT") @db.VarChar(30) // DRAFT, ACTIVE, INACTIVE
  priority       Int
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rules        PolicyRule[]

  @@index([organizationId])
  @@index([workspaceId])
  @@index([status])
  @@map("policies")
}

model PolicyRule {
  id            String   @id @default(uuid()) @db.Uuid
  policyId      String   @map("policy_id") @db.Uuid
  ruleType      String   @map("rule_type") @db.VarChar(50)
  operator      String   @db.VarChar(30)
  value         String   @db.VarChar(255)
  unit          String?  @db.VarChar(30)
  enabled       Boolean  @default(true)
  priority      Int      @default(0)
  configuration String   @db.Text // JSON configuration
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@map("policy_rules")
}

model PolicyEvaluation {
  id              String   @id @default(uuid()) @db.Uuid
  decisionId      String   @map("decision_id") @db.Uuid
  policyId        String   @map("policy_id") @db.Uuid
  correlationId   String   @map("correlation_id") @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  outcome         String   @db.VarChar(30) // ALLOW, REJECT
  policyVersion   Int      @map("policy_version")
  violations      String   @db.Text // JSON array of violations
  effectiveLimits String   @map("effective_limits") @db.Text // JSON object of effective limits
  explanation     String   @db.Text // JSON explanation
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([correlationId, policyId])
  @@index([decisionId])
  @@index([workspaceId])
  @@index([organizationId])
  @@map("policy_evaluations")
}

model PolicyResolutionState {
  correlationId       String   @id @map("correlation_id") @db.Uuid
  decisionId          String   @unique @map("decision_id") @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  workspaceId         String   @map("workspace_id") @db.Uuid
  expectedPolicyCount Int?     @map("expected_policy_count")
  status              String   @default("PENDING") @db.VarChar(30) // PENDING, RESOLVED, FAILED
  finalOutcome        String?  @db.VarChar(30) // ALLOW, REJECT
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([workspaceId])
  @@index([organizationId])
  @@map("policy_resolution_states")
}

// -----------------------------------------------------------------------------
// EXECUTION SCHEMA
// -----------------------------------------------------------------------------

model ExecutionOrder {
  id                 String    @id @default(uuid()) @db.Uuid
  workspaceId        String    @map("workspace_id") @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  accountId          String    @map("account_id") @db.Uuid
  symbolId           String    @map("symbol_id") @db.Uuid
  decisionId         String?   @map("decision_id") @db.Uuid
  correlationId      String?   @map("correlation_id") @db.Uuid
  orderType          String    @map("order_type") @db.VarChar(50) // MARKET, LIMIT, STOP
  side               String    @db.VarChar(10) // BUY, SELL
  status             String    @default("PENDING") @db.VarChar(30)
  size               Decimal   @db.Decimal(18, 4)
  requestedPrice     Decimal?  @map("requested_price") @db.Decimal(18, 8)
  executedPrice      Decimal?  @map("executed_price") @db.Decimal(18, 8)
  executedSize       Decimal   @default(0) @map("executed_size") @db.Decimal(18, 4)
  remainingSize      Decimal   @map("remaining_size") @db.Decimal(18, 4)
  stopLoss           Decimal?  @map("stop_loss") @db.Decimal(18, 8)
  takeProfit         Decimal?  @map("take_profit") @db.Decimal(18, 8)
  connectorCommandId String?   @map("connector_command_id") @db.Uuid
  brokerOrderId      String?   @map("broker_order_id") @db.VarChar(100)
  brokerTicketId     String?   @map("broker_ticket_id") @db.VarChar(100)
  magicNumber        String?   @map("magic_number") @db.VarChar(50)
  failureReason      String?   @map("failure_reason") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  completedAt        DateTime? @map("completed_at") @db.Timestamp(6)

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace             Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  portfolioTransactions PortfolioTransaction[]
  executionFills        ExecutionFill[]

  @@unique([decisionId])
  @@index([workspaceId])
  @@index([organizationId])
  @@index([accountId])
  @@index([status])
  @@index([connectorCommandId])
  @@map("execution_orders")
}

model ExecutionFill {
  id                String   @id @default(uuid()) @db.Uuid
  executionOrderId  String   @map("execution_order_id") @db.Uuid
  clientExecutionId String?  @unique @map("client_execution_id") @db.Uuid
  brokerTicketId    String?  @map("broker_ticket_id") @db.VarChar(100)
  brokerDealId      String?  @map("broker_deal_id") @db.VarChar(100)
  brokerOrderId     String?  @map("broker_order_id") @db.VarChar(100)
  executedSize      Decimal  @map("executed_size") @db.Decimal(18, 4)
  executedPrice     Decimal  @map("executed_price") @db.Decimal(18, 8)
  commission        Decimal? @db.Decimal(18, 8)
  swap              Decimal? @db.Decimal(18, 8)
  realizedPnl       Decimal? @map("realized_pnl") @db.Decimal(18, 8)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  executionOrder ExecutionOrder @relation(fields: [executionOrderId], references: [id], onDelete: Cascade)

  @@unique([executionOrderId, brokerDealId])
  @@map("execution_fills")
}

// -----------------------------------------------------------------------------
// BACKTESTING SCHEMA
// -----------------------------------------------------------------------------

model BacktestJob {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  strategyId      String    @map("strategy_id") @db.Uuid
  strategyVersion String    @map("strategy_version") @db.VarChar(50)
  correlationId   String?   @map("correlation_id") @db.Uuid
  eaId            String?   @map("ea_id") @db.Uuid
  workerId        String?   @map("worker_id") @db.Uuid
  symbols         String    @db.Text // JSON array of symbols
  dateFrom        DateTime  @map("date_from") @db.Timestamp(6)
  dateTo          DateTime  @map("date_to") @db.Timestamp(6)
  status          String    @default("CREATED") @db.VarChar(30)
  requestedBy     String    @map("requested_by") @db.Uuid
  configuration   String?   @db.Text // JSON config
  initialCapital  Decimal   @map("initial_capital") @db.Decimal(18, 2)
  spread          Decimal?  @db.Decimal(18, 5)
  slippage        Decimal?  @db.Decimal(18, 5)
  commission      Decimal?  @db.Decimal(18, 5)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  completedAt     DateTime? @map("completed_at") @db.Timestamp(6)

  workspace    Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  strategy     Strategy               @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  results      BacktestResult[]
  tradeHistory BacktestTradeHistory[]

  @@index([workspaceId])
  @@index([status])
  @@map("backtest_jobs")
}

model BacktestResult {
  id             String  @id @default(uuid()) @db.Uuid
  backtestJobId  String  @unique @map("backtest_job_id") @db.Uuid
  totalTrades    Int     @map("total_trades")
  winningTrades  Int     @map("winning_trades")
  losingTrades   Int     @map("losing_trades")
  winRate        Decimal @map("win_rate") @db.Decimal(5, 2)
  netProfit      Decimal @map("net_profit") @db.Decimal(18, 2)
  grossProfit    Decimal @map("gross_profit") @db.Decimal(18, 2)
  grossLoss      Decimal @map("gross_loss") @db.Decimal(18, 2)
  maxDrawdown    Decimal @map("max_drawdown") @db.Decimal(18, 2)
  recoveryFactor Decimal @map("recovery_factor") @db.Decimal(10, 4)
  sharpeRatio    Decimal @map("sharpe_ratio") @db.Decimal(10, 4)
  profitFactor   Decimal @map("profit_factor") @db.Decimal(10, 4)

  job BacktestJob @relation(fields: [backtestJobId], references: [id], onDelete: Cascade)

  @@map("backtest_results")
}

model BacktestTradeHistory {
  id            String   @id @default(uuid()) @db.Uuid
  backtestJobId String   @map("backtest_job_id") @db.Uuid
  symbol        String   @db.VarChar(50)
  direction     String   @db.VarChar(10)
  entryPrice    Decimal  @map("entry_price") @db.Decimal(18, 8)
  exitPrice     Decimal  @map("exit_price") @db.Decimal(18, 8)
  stopLoss      Decimal? @map("stop_loss") @db.Decimal(18, 8)
  takeProfit    Decimal? @map("take_profit") @db.Decimal(18, 8)
  lotSize       Decimal  @map("lot_size") @db.Decimal(18, 4)
  pnl           Decimal  @db.Decimal(18, 2)
  openedAt      DateTime @map("opened_at") @db.Timestamp(6)
  closedAt      DateTime @map("closed_at") @db.Timestamp(6)

  job BacktestJob @relation(fields: [backtestJobId], references: [id], onDelete: Cascade)

  @@index([backtestJobId])
  @@map("backtest_trade_history")
}

model OutboxMessage {
  id             String    @id @default(uuid()) @db.Uuid
  aggregateType  String    @map("aggregate_type") @db.VarChar(100)
  aggregateId    String    @map("aggregate_id") @db.Uuid
  eventType      String    @map("event_type") @db.VarChar(255)
  payload        Json
  status         String    @default("PENDING") @db.VarChar(20) // PENDING, PROCESSING, COMPLETED, FAILED
  lockedUntil    DateTime? @map("locked_until") @db.Timestamp(6)
  lockedBy       String?   @map("locked_by") @db.VarChar(255)
  retryCount     Int       @default(0) @map("retry_count")
  error          String?   @db.Text
  correlationId  String?   @map("correlation_id") @db.Uuid
  idempotencyKey String?   @unique @map("idempotency_key") @db.VarChar(255)
  organizationId String?   @map("organization_id") @db.Uuid
  workspaceId    String?   @map("workspace_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([status, lockedUntil])
  @@index([createdAt])
  @@map("outbox_messages")
}

// -----------------------------------------------------------------------------
// AI SCHEMA
// -----------------------------------------------------------------------------

model AIModel {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  provider       String   @db.VarChar(100)
  modelName      String   @map("model_name") @db.VarChar(100)
  modelVersion   String   @map("model_version") @db.VarChar(50)
  status         String   @default("ACTIVE") @db.VarChar(30) // ACTIVE, INACTIVE, DEPRECATED
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recommendations AIRecommendation[]

  @@unique([workspaceId, provider, modelName, modelVersion])
  @@index([organizationId])
  @@index([workspaceId])
  @@index([status])
  @@map("ai_models")
}

model AIConfiguration {
  id                       String    @id @default(uuid()) @db.Uuid
  organizationId           String    @map("organization_id") @db.Uuid
  workspaceId              String    @unique @map("workspace_id") @db.Uuid
  enabled                  Boolean   @default(false)
  executionMode            String    @map("execution_mode") @db.VarChar(30) // SIGNAL_ONLY, AI_EXECUTE, HYBRID
  minimumConfidence        Decimal   @map("minimum_confidence") @db.Decimal(5, 2)
  maxRiskPerTrade          Decimal   @map("max_risk_per_trade") @db.Decimal(5, 2)
  maxDailyLoss             Decimal   @map("max_daily_loss") @db.Decimal(5, 2)
  maxOpenPositions         Int       @map("max_open_positions")
  maxPositionSize          Decimal   @map("max_position_size") @db.Decimal(24, 8)
  requirePolicyApproval    Boolean   @default(true) @map("require_policy_approval")
  allowedSymbols           String?   @map("allowed_symbols") @db.Text // JSON array or comma separated
  allowedSessions          String?   @map("allowed_sessions") @db.Text
  inferenceIntervalMinutes Int       @default(60) @map("inference_interval_minutes")
  lastInferenceAt          DateTime? @map("last_inference_at") @db.Timestamp(6)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("ai_configurations")
}

model AIRecommendation {
  id                 String  @id @default(uuid()) @db.Uuid
  organizationId     String  @map("organization_id") @db.Uuid
  workspaceId        String  @map("workspace_id") @db.Uuid
  correlationId      String  @map("correlation_id") @db.Uuid
  idempotencyKey     String  @unique @map("idempotency_key") @db.VarChar(255)
  modelId            String  @map("model_id") @db.Uuid
  modelVersion       String  @map("model_version") @db.VarChar(50)
  strategyId         String? @map("strategy_id") @db.Uuid
  symbolId           String  @map("symbol_id") @db.Uuid
  executionMode      String  @map("execution_mode") @db.VarChar(30)
  recommendationType String  @map("recommendation_type") @db.VarChar(50)
  confidence         Decimal @db.Decimal(5, 2)
  marketRegime       String? @map("market_regime") @db.VarChar(50)

  suggestedSide       String?  @map("suggested_side") @db.VarChar(10)
  suggestedSize       Decimal? @map("suggested_size") @db.Decimal(24, 8)
  suggestedEntry      Decimal? @map("suggested_entry") @db.Decimal(24, 8)
  suggestedStopLoss   Decimal? @map("suggested_stop_loss") @db.Decimal(24, 8)
  suggestedTakeProfit Decimal? @map("suggested_take_profit") @db.Decimal(24, 8)

  reasoning         String? @db.Text
  supportingSignals String? @map("supporting_signals") @db.Text // JSON array

  status String @db.VarChar(30) // GENERATING, GENERATED, REJECTED, EXPIRED, EXECUTION_REQUESTED, COMPLETED, FAILED

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  model        AIModel      @relation(fields: [modelId], references: [id])
  symbol       Symbol       @relation(fields: [symbolId], references: [id])

  @@index([organizationId])
  @@index([workspaceId])
  @@index([correlationId])
  @@index([status])
  @@map("ai_recommendations")
}

// -----------------------------------------------------------------------------
// ORCHESTRATION SCHEMA
// -----------------------------------------------------------------------------

model SignalIntent {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  correlationId    String   @map("correlation_id") @db.Uuid
  symbolId         String   @map("symbol_id") @db.Uuid
  source           String   @db.VarChar(50) // AI, STRATEGY
  sourceId         String   @map("source_id") @db.Uuid // AIRecommendation ID or Strategy ID
  direction        String   @db.VarChar(10) // BUY, SELL
  size             Decimal? @db.Decimal(24, 8)
  status           String   @default("PENDING") @db.VarChar(30) // PENDING, PROCESSING, RESOLVED, DROPPED, CONFLICT_REQUIRES_RESOLUTION
  resolutionReason String?  @map("resolution_reason") @db.Text
  timeWindow       DateTime @map("time_window") @db.Timestamp(6) // Truncated bucket time
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, sourceId])
  @@index([workspaceId, symbolId, timeWindow, status])
  @@index([correlationId])
  @@map("signal_intents")
}

// -----------------------------------------------------------------------------
// RECONCILIATION SCHEMA
// -----------------------------------------------------------------------------

model PortfolioReconciliationSnapshot {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  workspaceId        String   @map("workspace_id") @db.Uuid
  tradingAccountId   String   @map("trading_account_id") @db.Uuid
  externalSnapshotId String   @map("external_snapshot_id") @db.VarChar(255)
  idempotencyKey     String   @unique @map("idempotency_key") @db.VarChar(255)
  snapshotTimestamp  DateTime @map("snapshot_timestamp") @db.Timestamp(6)
  status             String   @default("PENDING") @db.VarChar(30) // PENDING, COMPLETED, ANOMALIES_DETECTED
  payloadJson        String   @map("payload_json") @db.Text
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([tradingAccountId, snapshotTimestamp(sort: Desc)])
  @@map("portfolio_reconciliation_snapshots")
}

model PortfolioReconciliationDiscrepancy {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  snapshotId       String   @map("snapshot_id") @db.Uuid
  tradingAccountId String   @map("trading_account_id") @db.Uuid
  discrepancyType  String   @map("discrepancy_type") @db.VarChar(50) // EXTERNAL_POSITION_NOT_IN_INTERNAL, INTERNAL_POSITION_NOT_IN_EXTERNAL, BALANCE_MISMATCH
  symbolId         String?  @map("symbol_id") @db.Uuid
  positionId       String?  @map("position_id") @db.Uuid
  internalValue    String?  @map("internal_value") @db.Text
  externalValue    String?  @map("external_value") @db.Text
  status           String   @default("UNRESOLVED") @db.VarChar(30) // UNRESOLVED, RESOLVED_MANUALLY, IGNORED
  resolutionReason String?  @map("resolution_reason") @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([tradingAccountId, status])
  @@map("portfolio_reconciliation_discrepancies")
}

// -----------------------------------------------------------------------------
// COMMERCIAL SCHEMA (S-23 PHASE 01)
// -----------------------------------------------------------------------------

model MarketplaceProduct {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid // Vendor
  name           String  @db.VarChar(255)
  description    String? @db.Text
  productType    String  @map("product_type") @db.VarChar(50) // EA, STRATEGY, AI_MODEL
  assetId        String? @map("asset_id") @db.Uuid // Reference to actual EA/Strategy id
  pricingModel   String  @map("pricing_model") @db.VarChar(50) // SUBSCRIPTION, ONE_TIME, USAGE
  price          Decimal @db.Decimal(10, 2)
  currency       String  @default("USD") @db.VarChar(10)
  status         String  @default("ACTIVE") @db.VarChar(30)

  // New Fields for Marketplace
  version       String? @db.VarChar(50)
  iconUrl       String? @map("icon_url") @db.Text
  mediaUrls     String? @map("media_urls") @db.Text // JSON array
  features      String? @db.Text // JSON array
  requirements  String? @db.Text // JSON object
  averageRating Decimal @default(0.0) @map("average_rating") @db.Decimal(3, 2)
  reviewCount   Int     @default(0) @map("review_count")
  purchaseCount Int     @default(0) @map("purchase_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  licenses      License[]
  subscriptions ProductSubscription[]
  reviews       ProductReview[]

  @@index([organizationId])
  @@index([status])
  @@map("marketplace_products")
}

model ProductReview {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid // Reviewer context
  userId      String   @map("user_id") @db.Uuid // Actual user who wrote it
  rating      Int      @db.SmallInt // 1 to 5
  comment     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  product   MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, workspaceId]) // One review per workspace per product
  @@index([productId, rating])
  @@map("product_reviews")
}

model License {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid // Purchaser
  workspaceId    String    @map("workspace_id") @db.Uuid // Licensed workspace
  productId      String    @map("product_id") @db.Uuid
  licenseKey     String    @unique @map("license_key") @db.VarChar(255)
  status         String    @default("ACTIVE") @db.VarChar(30) // ACTIVE, REVOKED, EXPIRED
  issuedAt       DateTime  @default(now()) @map("issued_at") @db.Timestamp(6)
  expiresAt      DateTime? @map("expires_at") @db.Timestamp(6)
  subscriptionId String?   @map("subscription_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product      MarketplaceProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)
  subscription ProductSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, productId]) // One active license per workspace per product
  @@index([organizationId])
  @@index([workspaceId])
  @@index([productId])
  @@map("licenses")
}

model ProductSubscription {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  productId       String    @map("product_id") @db.Uuid
  status          String    @default("ACTIVE") @db.VarChar(30) // ACTIVE, PAST_DUE, CANCELED, EXPIRED
  billingPeriod   String    @map("billing_period") @db.VarChar(30) // MONTHLY, YEARLY
  nextBillingDate DateTime? @map("next_billing_date") @db.Timestamp(6)
  idempotencyKey  String?   @unique @map("idempotency_key") @db.VarChar(100)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product      MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  licenses     License[]
  invoices     Invoice[]

  @@index([organizationId])
  @@index([workspaceId])
  @@map("product_subscriptions")
}

model Invoice {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  subscriptionId String?   @map("subscription_id") @db.Uuid
  amount         Decimal   @db.Decimal(10, 2)
  currency       String    @default("USD") @db.VarChar(10)
  status         String    @default("DRAFT") @db.VarChar(30) // DRAFT, ISSUED, PAID, VOID
  issuedAt       DateTime  @default(now()) @map("issued_at") @db.Timestamp(6)
  paidAt         DateTime? @map("paid_at") @db.Timestamp(6)
  idempotencyKey String?   @unique @map("idempotency_key") @db.VarChar(100)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscription    ProductSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  lines           InvoiceLine[]
  paymentAttempts PaymentAttempt[]

  @@index([organizationId])
  @@index([workspaceId])
  @@map("invoices")
}

model InvoiceLine {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  description String   @db.VarChar(255)
  amount      Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model UsageRecord {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  productId      String?  @map("product_id") @db.Uuid
  metricName     String   @map("metric_name") @db.VarChar(100)
  quantity       Decimal  @db.Decimal(18, 8)
  timestamp      DateTime @default(now()) @db.Timestamp(6)
  idempotencyKey String?  @unique @map("idempotency_key") @db.VarChar(100)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, metricName, timestamp])
  @@map("usage_records")
}

model BillingLedgerEntry {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  accountId       String?  @map("account_id") @db.Uuid
  amount          Decimal  @db.Decimal(10, 2)
  currency        String   @db.VarChar(10)
  transactionType String   @map("transaction_type") @db.VarChar(50) // CHARGE, PAYMENT, REFUND, CREDIT
  description     String   @db.Text
  idempotencyKey  String   @unique @map("idempotency_key") @db.VarChar(100)
  referenceId     String?  @map("reference_id") @db.Uuid // e.g. invoice id
  referenceType   String?  @map("reference_type") @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([workspaceId])
  @@map("billing_ledger_entries")
}

model PaymentAttempt {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  invoiceId         String   @map("invoice_id") @db.Uuid
  provider          String   @db.VarChar(50) // MOCK, STRIPE, etc.
  providerPaymentId String?  @map("provider_payment_id") @db.VarChar(255)
  amount            Decimal  @db.Decimal(10, 2)
  currency          String   @db.VarChar(10)
  status            String   @db.VarChar(30) // PENDING, SUCCESS, FAILED
  errorMessage      String?  @map("error_message") @db.Text
  idempotencyKey    String   @unique @map("idempotency_key") @db.VarChar(100)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payment_attempts")
}


model ProcessedEvent {
  eventId    String   @map("event_id") @db.VarChar(255)
  consumerId String   @map("consumer_id") @db.VarChar(255)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamp(6)
  @@unique([eventId, consumerId])
  @@map("processed_events")
}

model IdempotentCommand {
  idempotencyKey String   @id @map("idempotency_key") @db.VarChar(255)
  commandName    String   @map("command_name") @db.VarChar(100)
  organizationId String?  @map("organization_id") @db.Uuid
  workspaceId    String?  @map("workspace_id") @db.Uuid
  resultId       String?  @map("result_id") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  @@map("idempotent_commands")
}
