  riskProfile    String   @map("risk_profile") @db.VarChar(50)
  status         String   @default("DRAFT") @db.VarChar(30)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expertAdvisors ExpertAdvisor[]
  evaluations    StrategyEvaluationHistory[] @relation("SelectedStrategy")
  metrics        StrategyMetrics?
  backtestJobs   BacktestJob[]

  @@unique([organizationId, name, version])
  @@index([organizationId])
  @@index([status])
