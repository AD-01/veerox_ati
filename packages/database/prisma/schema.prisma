}

model ExpertAdvisor {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  strategyId     String   @map("strategy_id") @db.Uuid
  version        String   @db.VarChar(50)
  binaryUrl      String?  @map("binary_url") @db.Text
  sourceUrl      String?  @map("source_url") @db.Text
  signature      String?  @db.Text
  status         String   @default("DRAFT") @db.VarChar(30)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  strategy     Strategy     @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([strategyId])
  @@map("expert_advisors")
}

model StrategyEvaluationHistory {
  id                  String   @id @default(uuid()) @db.Uuid
  workspaceId         String   @map("workspace_id") @db.Uuid
  timestamp           DateTime @default(now()) @db.Timestamp(6)
  candidateStrategies String   @map("candidate_strategies") @db.Text // JSON array of strategy IDs
