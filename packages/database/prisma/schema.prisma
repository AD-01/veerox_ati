model StrategyOrchestration {
  workspaceId            String   @id @map("workspace_id") @db.Uuid
  currentStrategyId      String?  @map("current_strategy_id") @db.Uuid
  currentExpertAdvisorId String?  @map("current_expert_advisor_id") @db.Uuid
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

