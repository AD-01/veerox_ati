  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  selectedStrategy Strategy? @relation("SelectedStrategy", fields: [selectedStrategyId], references: [id])

  @@index([workspaceId, timestamp(sort: Desc)])
  @@map("strategy_evaluations")
}

model StrategyMetrics {
  strategyId            String   @id @map("strategy_id") @db.Uuid
  organizationId        String   @map("organization_id") @db.Uuid
  confidenceScore       Decimal  @map("confidence_score") @db.Decimal(5, 2)
  historicalPerformance String   @map("historical_performance") @db.VarChar(30)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  strategy     Strategy     @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("strategy_metrics")
}

model StrategyMetricsReadModel {
  strategyId            String   @id @map("strategy_id") @db.Uuid
  workspaceId           String   @map("workspace_id") @db.Uuid
  confidenceScore       Decimal  @map("confidence_score") @db.Decimal(5, 2)
  historicalPerformance String   @map("historical_performance") @db.VarChar(30)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("strategy_metrics_read")
}

model OpenPositionReadModel {
